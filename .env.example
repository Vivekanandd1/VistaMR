# ===========================================
# PreVista Automation Framework - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env file with actual credentials to version control!
# ===========================================

# ==================== Application Profile ====================
# Options: local, qa, staging, prod, ci
PROFILE=local

# ==================== Browser Configuration ====================
# Supported browsers: chrome, firefox, edge
BROWSER=chrome

# Run browser in headless mode (true/false)
# Set to false for local debugging with visible browser
HEADLESS=false

# ==================== Test Credentials (REQUIRED) ====================
# These are mandatory for test execution
# Get these from your test environment administrator
Email=your-test-email@example.com
Password=your-test-password

# ==================== Database Configuration (Optional) ====================
# Only required if running database tests
DB_HOST=localhost
DB_PORT=3306
DB_NAME=UserCred
DB_USER=root
DB_PASSWORD=your-db-password

# ==================== CI/CD Environment Variables ====================
# These are typically set by your CI/CD pipeline (GitHub Actions, Jenkins, etc.)
# Do not set these locally unless testing CI behavior

# CI=true

# ==================== Remote WebDriver (Optional) ====================
# For Selenium Grid or cloud providers (BrowserStack, Sauce Labs)
# REMOTE_EXECUTION=true
# REMOTE_WEBDRIVER_URL=http://localhost:4444/wd/hub

# ==================== Custom Configuration Overrides ====================
# Override any application.properties values here
# IMPLICIT_WAIT=15
# EXPLICIT_WAIT=45
# MAX_RETRY_COUNT=3
